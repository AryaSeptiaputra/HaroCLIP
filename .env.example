# Anthropic — required for highlight detection (src/highlights/llm.py calls the
# Claude API, not a local model). Get a key from console.anthropic.com. Never commit
# a real key; this file is the template, actual values go in a local .env (gitignored)
# or the environment directly.
# ANTHROPIC_API_KEY=

# Hugging Face — optional but recommended on vast.ai: avoids the "unauthenticated
# requests" rate limit warning when downloading whisper weights. Use a READ-ONLY
# token (huggingface.co/settings/tokens, role "Read") — we only download public
# models, never upload.
# HF_TOKEN=

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Paths (override defaults if needed)
DATA_DIR=./data

# Model overrides (all optional — defaults are the production settings; only useful
# for cheap local verification with smaller substitute models, see CLAUDE.md)
# WHISPER_MODEL_SIZE=large-v3
# WHISPER_DEVICE=cuda
# HIGHLIGHT_LLM_MODEL=claude-sonnet-5
# YOLOV8_FACE_WEIGHTS_PATH=data/models/yolov8n-face-lindevs.pt
