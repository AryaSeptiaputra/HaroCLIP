# Hugging Face — optional but recommended on vast.ai: avoids the "unauthenticated
# requests" rate limit warning when downloading whisper/Qwen weights. Use a READ-ONLY
# token (huggingface.co/settings/tokens, role "Read") — we only download public
# models, never upload. Never commit a real token; this file is the template, actual
# values go in a local .env (gitignored) or the environment directly.
# HF_TOKEN=

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Paths (override defaults if needed)
DATA_DIR=./data

# Model overrides (all optional — defaults are the production settings; only useful
# for cheap local verification with smaller substitute models, see CLAUDE.md)
# WHISPER_MODEL_SIZE=large-v3
# WHISPER_DEVICE=cuda
# HIGHLIGHT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# HIGHLIGHT_LLM_4BIT=1
# HIGHLIGHT_LLM_DEVICE_MAP=cuda
# YOLOV8_FACE_WEIGHTS_PATH=data/models/yolov8n-face-lindevs.pt
